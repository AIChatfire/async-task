# ---- 异步网关配置样例（变量一律 `AG_` 前缀；嵌套用双下划线，如 AG_S3__ENDPOINT）----
# 用法：cp .env.example .env 后按下面「生产部署必改项」逐条改；**切勿把 .env 提交进仓库**。
# 本文件是配置项的**权威清单**：代码里 Settings 的每个字段都在此登记（有测试守着，见
# tests/test_env_contract.py）。带 `# 代码默认:` 的项说明本文件给的是**部署建议值**而非代码默认。
#
# ⚠️ 前缀是**刻意保留**的（2026-09-21 复核）：部署环境常导出通用同名变量（如 `DATABASE_URL` /
#    `REDIS_URL` / `LOG_LEVEL`），无前缀时它们会被静默读到并顶掉本文件的值。
# ⚠️ 留空项不要写成「等号 + 空格 + #注释」——解析器会把注释整段当成值（fail-open）。
#    要么 `KEY=`，要么 `KEY=值  # 注释`。

# ============ 生产部署必改项（照抄样例会上不去或上成开发配置）============
#   AG_APP_ENV=prod                     dev 下不启用生产约束
#   AG_DATABASE_URL                     生产 PG；口令走 Secret 注入，不落本文件
#   AG_REDIS_URL                        生产 Redis（Streams + 计数 + 轮询直方图 + 请求体/凭证短存）
#   AG_CALLBACK_BASE_URL                必须换成**调用方可达**的地址（结果链接也用它拼）
#   AG_CALLBACK_HMAC_KEYS/KID           ★ 必须换掉 dev-only-secret，否则回调可被伪造
#   AG_ADMIN_TOKEN                      ★ 治理面令牌，必须换（dev 值是公开的）
#   AG_AUTH_MODE / AG_OWNERSHIP_CHECK / SSRF_*   安全项逐条复核（见各组注释）
#   AG_RESULT_MODE_DEFAULT              是否接受「上游直链」取决于产物能否公开
#   S3_*（可选）                     只有要用「结果转存」才需要配（见对象存储一节）
# =====================================================================

# ---- 基础 ----
AG_APP_ENV=dev
AG_LOG_LEVEL=INFO
# 留空 = 不开遥测。⚠️ 别写占位符：非空会被当成真 token，每次都往 Logfire 发请求并 401。
AG_LOGFIRE_TOKEN=
AG_SERVICE_NAME=async-gateway

# 真相库（Postgres）。开发/测试可用 sqlite+aiosqlite:///./dev.db
# 注：create 请求体与受理响应存档**不在库里**，走 Redis（infra/request_store）。
AG_DATABASE_URL=postgresql+asyncpg://async_gateway:async_gateway@localhost:5432/async_gateway
AG_DB_ECHO=false
AG_DB_POOL_SIZE=10
AG_DB_MAX_OVERFLOW=20

# broker 与缓存（Redis Streams + 并发计数 + 轮询直方图 + 请求体/凭证短生命周期存放）
AG_REDIS_URL=redis://localhost:6379/0
# stream = Redis Streams（生产）；taskiq 需安装 [queue] 额外依赖；memory 仅单进程调试
AG_QUEUE_DRIVER=stream
AG_QUEUE_STREAM_PREFIX=ag:q:
AG_QUEUE_GROUP=ag-workers
AG_QUEUE_MAX_DEPTH=100000

# ---- 对象存储（**可选件**：只服务「结果转存」；不配置 ⇒ 转存自动关闭）----
# 2026-09-21 裁定：转存只走**外部** MinIO/S3；create 请求体/响应存档不走对象存储（走 Redis）。
# **四项（AG_S3_ENDPOINT/ACCESS_KEY/SECRET_KEY/BUCKET）任缺一项 = 未配置**：模板即使声明 store
# 也不转存，查询响应保留上游直链并在 envelope degraded[] 里声明（转存自动关闭，不报错、不重试）。
# 结果 key 形态：{YYYYMMDD}/{tenant}/{task_id}/attempt-n.bin（一级是任务创建日期，便于按天清理）。
# ⚠️ 桶的读权限决定结果的公开性：若桶允许匿名 GetObject/ListBucket（共享 CDN 桶的常见配置），
#    转存出去的产物即公开资源 —— 任何人可读、也可枚举发现。**请勿放入敏感产物。**
AG_S3_ENDPOINT=https://oss.s3ai.cn
AG_S3_ACCESS_KEY=
AG_S3_SECRET_KEY=
AG_S3_BUCKET=cdn

# ---- 策略组默认值（模板 / 渠道可覆盖）----
AG_IDEMPOTENCY_WINDOW_SECONDS=86400
AG_MAX_ATTEMPTS=3
AG_TASK_DEADLINE_SECONDS=1800
AG_RESULT_RETENTION_DAYS=30
AG_RESULT_PRESIGN_TTL_SECONDS=900
# 结果文件单次拉取上限（转存用）。与"上游 API 响应体上限"（4 MiB，JSON 状态响应）是两件事：
# 实测火山 3D 产物 41 MB，视频产物量级更高，沿用 4 MiB 会确定性失败。
AG_RESULT_MAX_BYTES=268435456
# 结果策略的全局默认（模板未显式声明 result_policy.mode 时生效）
#   passthrough = 不转存、查询响应直接给上游直链（当前默认）：链路最短，
#     代价是链接依赖上游有效期、且上游直链暴露给调用方
#   store = 转存到对象存储、给预签名 URL（前提：上面 S3_* 已配置且对调用方可达）
AG_RESULT_MODE_DEFAULT=passthrough
# 提交后「已调上游但未落库」的确认窗口（§14 提交不确定）
AG_SUBMIT_CONFIRM_WINDOW_SECONDS=120

# 背压：受理速率配额与上游并发槽分离计数（§4.3）
AG_ACCEPT_RATE_PER_SECOND=20
AG_ACCEPT_BURST=40
AG_CHANNEL_CONCURRENCY=16
AG_TENANT_CONCURRENCY=8

# 自适应轮询（§15）
AG_POLL_BASE_INTERVAL=3
AG_POLL_MIN_INTERVAL=3
AG_POLL_MAX_INTERVAL=60
AG_POLL_INITIAL_INTERVAL=5
AG_POLL_HOT_START_SAMPLES=30

# 查询面（§12.2）：快照优先 + per-task 最小刷新间隔
AG_MIN_REFRESH_INTERVAL=3

# unknown 有界化（§4.4 / §14）
AG_UNKNOWN_MAX_PER_CHANNEL=200
AG_UNKNOWN_MAX_LIFETIME_SECONDS=3600

# 上游超时（秒）
AG_SUBMIT_CONNECT_TIMEOUT=5
AG_SUBMIT_READ_TIMEOUT=30
AG_POLL_READ_TIMEOUT=10

# ---- 认证（§11 / §18.2）----
# passthrough = 上游凭证随 Authorization 头透传（数据面不存 key，推荐）
AG_AUTH_MODE=passthrough
# 查询面归属校验：任务必须属于同一渠道/租户才可见（生产保持 true）
AG_OWNERSHIP_CHECK=true
# 上游要求的凭证头名（如某些上游用 X-Api-Key）
AG_UPSTREAM_AUTH_HEADER=Authorization
# 受理模式：queued（默认）= 不等上游、立刻 202，上游 create 由 worker 后台完成；
# inline = 受理请求内同步创建（返回上游原生形状；上游受理慢则受理慢）
AG_SUBMIT_MODE=queued

# ---- SSRF（§18.1）----
# 出站白名单（空 = 只做内网/metadata 判定，不做域名白名单）。JSON 数组或逗号分隔
AG_SSRF_ALLOW_HOSTS=[]
AG_SSRF_ALLOW_SCHEMES=["https","http"]
# 解析并钉住 DNS（防 DNS rebinding）；生产保持 true
AG_SSRF_PIN_DNS=true
# 拒绝私网/回环/metadata 地址；生产保持 true（自建内网上游时才按需放开）
AG_SSRF_DENY_PRIVATE=true
# URL 直配过渡能力（独立指标 + 一键全局关闭）
AG_URL_DIRECT_CONFIG_ENABLED=true
AG_URL_DIRECT_ALLOWED_PREFIXES=[]

# ---- 回调（§18.3）----
# ★ 生产必须换：下面两条 dev 值等于"回调可被任何人伪造"
# JSON 对象格式，例如 {"k1":"<secret1>","k2":"<secret2>"}（双密钥用于灰度轮换）
AG_CALLBACK_HMAC_KEYS={"k1":"dev-only-secret"}
AG_CALLBACK_ACTIVE_KID=k1
# 验签时间窗（秒）
AG_CALLBACK_TOLERANCE_SECONDS=300
# 回调地址基址：**必须是对调用方可达的地址**，不是容器内部名
AG_CALLBACK_BASE_URL=http://localhost:8000

# ---- 治理面（§18.4）----
# ★ 生产必须换：dev 值是公开的
AG_ADMIN_TOKEN=dev-admin-token
AG_REPLAY_RATE_PER_MINUTE=100

# ---- 进程巡检周期 ----
AG_SCHEDULER_TICK_SECONDS=1.0
AG_SCHEDULER_BATCH_SIZE=500
AG_INSPECTOR_TICK_SECONDS=15.0
# 受理后多久仍未提交 → 判定为"入队失败/消息丢失"，条件更新重投
AG_ACCEPTED_STALL_SECONDS=60
